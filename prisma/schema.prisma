// Schéma Prisma — préparation sync v2 (SQLite local / Postgres cloud)
// Client généré : npx prisma generate (quand DATABASE_URL sera configurée)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Compte établissement (aligné storageAccountId)
model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
  products  Product[]
  clients   Client[]
  sales     Sale[]
}

model User {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  email            String   @unique
  passwordHash     String
  role             String
  displayName      String?
  storageAccountId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Product {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  sku               String
  name              String
  price             Float
  stock             Int      @default(0)
  criticalThreshold Int      @default(10)
  type              String?
  active            Boolean  @default(true)
  localId           String?  /// id localStorage pour mapping sync
  updatedAt         DateTime @updatedAt

  @@unique([tenantId, sku])
}

model Client {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String?
  name      String
  phone     String?
  localId   String?
  updatedAt DateTime @updatedAt
}

model Sale {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  saleNumber String
  total      Float
  status     String
  date       DateTime
  localId    String?
  payload    String?  /// JSON lignes + métadonnées
  syncedAt   DateTime?
  createdAt  DateTime @default(now())
}

/// Journal sync FIFO (miroir utils/syncQueue.ts)
model SyncOutbox {
  id        String   @id @default(cuid())
  tenantId  String
  entity    String
  operation String
  payload   String
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
}
