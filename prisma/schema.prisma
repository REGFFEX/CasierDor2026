// Schéma Prisma — préparation sync v2 (SQLite local / Postgres cloud)
// Client généré : npx prisma generate (quand DATABASE_URL sera configurée)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Compte établissement (aligné storageAccountId)
model Tenant {
  id               String   @id @default(cuid())
  name             String
  /// Informations d'onboarding
  activityType     String?
  sector           String?
  companySize      String?
  acquisitionChannel String?
  useCases         String?  // JSON stringifié des cas d'usage
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users            User[]
  products         Product[]
  clients          Client[]
  sales            Sale[]
  subscriptions    Subscription[]
  activities       Activity[]
  trashItems       TrashItem[]
}

model User {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  email            String   @unique
  passwordHash     String
  role             String
  displayName      String?
  storageAccountId String?
  isSuperAdmin     Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Plan {
  id               String   @id @default(cuid())
  code             String   @unique // FREE, PRO, BUSINESS, BUSINESS_PRO, ENTERPRISE
  name             String
  price            Float    @default(0.0)
  currency         String   @default("XAF")
  interval         String   @default("month")
  
  // Limites / Quotas
  maxUsers         Int      @default(1)
  maxStores        Int      @default(1)
  maxStorageMB     Int      @default(100)
  
  // Fonctionnalités (JSON pour flexibilité)
  features         String   // JSON stringifié (ex: { "cloudSync": true, "advancedReports": false })
  
  subscriptions    Subscription[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Subscription {
  id                  String   @id @default(cuid())
  tenantId            String
  tenant              Tenant   @relation(fields: [tenantId], references: [id])
  planId              String
  plan                Plan     @relation(fields: [planId], references: [id])
  status              String   // active, past_due, canceled, trialing
  trialEndsAt         DateTime?
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Product {
  id                String   @id @default(cuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  sku               String
  name              String
  price             Float
  stock             Int      @default(0)
  criticalThreshold Int      @default(10)
  type              String?
  active            Boolean  @default(true)
  localId           String?  /// id localStorage pour mapping sync
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  @@unique([tenantId, sku])
}

model Client {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String?
  name      String
  phone     String?
  localId   String?
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}

model Sale {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  saleNumber String
  total      Float
  status     String
  date       DateTime
  localId    String?
  payload    String?  /// JSON lignes + métadonnées
  syncedAt   DateTime?
  createdAt  DateTime @default(now())
  deletedAt  DateTime?
}

/// Journal sync FIFO (miroir utils/syncQueue.ts)
model SyncOutbox {
  id        String   @id @default(cuid())
  tenantId  String
  entity    String
  operation String
  payload   String
  attempts  Int      @default(0)
  lastError String?
  createdAt DateTime @default(now())
}

/// Traçabilité Globale : Historique des actions
model Activity {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userName  String
  userRole  String?
  action    String
  details   String?
  module    String?
  timestamp DateTime @default(now())
  payload   String?  /// Copie JSON des données modifiées
}

/// Corbeille globale pour conservation des données soft-deleted
model TrashItem {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  originalId  String
  module      String
  data        String   /// JSON complet de l'objet supprimé
  deletedAt   DateTime @default(now())
  expiresAt   DateTime /// Date de suppression définitive calculée
}
